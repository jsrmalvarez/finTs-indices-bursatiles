{
  "name": "indices-bursatiles",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Visualización estática de índices bursátiles con datos diarios históricos",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:download": "tsx scripts/download-data.ts",
    "data:convert": "tsx scripts/convert-data.ts",
    "data:refresh": "npm run data:download && npm run data:convert"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "lightweight-charts": "^4.2.1"
  }
}
